# =============================================================================
# TELEGRAM JUKEBOX BOT — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in every value marked [REQUIRED].
# Values marked [REQUIRED] have no default and will cause startup failure
# if absent. Values marked [OPTIONAL] have safe production defaults shown.
#
# SECURITY RULES:
#   - Never commit .env to version control (it is in .gitignore).
#   - Never log any value from this file (structlog scrubs keys matching
#     *TOKEN*, *SECRET*, *HASH*, *PASSWORD*, *KEY* automatically).
#   - Rotate BOT_TOKEN, API_ID, and API_HASH immediately on suspected leak.
#   - All values are validated at startup by src/config.py (Pydantic
#     BaseSettings). Invalid types or out-of-range values raise on import,
#     not at runtime.
#
# VALIDATION REFERENCE: src/config.py
# SECRETS AUDIT:        docs/ops-runbook.md § Secrets Rotation
# =============================================================================


# =============================================================================
# § 1  TELEGRAM CREDENTIALS                                      [REQUIRED ×3]
# =============================================================================
# All three values are required. The bot cannot authenticate to Telegram
# without them. Obtain from https://my.telegram.org (API_ID / API_HASH)
# and https://t.me/BotFather (BOT_TOKEN).
#
# BOT_TOKEN  — BotFather-issued token for the bot account.
#              Format: {bot_id}:{random_string}
#              Example structure (not a real token): 123456789:AAF...xyz
#
# API_ID     — Integer application ID from my.telegram.org.
#              Required by pyrogram/pytgcalls for MTProto voice-chat sessions.
#              Without this, StreamEngine cannot join voice chats.
#
# API_HASH   — 32-character hex string paired with API_ID.
#              Treat as a password — same rotation policy applies.
# -----------------------------------------------------------------------------

BOT_TOKEN=                        # [REQUIRED] e.g. 7123456789:AAHdqTcvCH...
API_ID=                           # [REQUIRED] e.g. 12345678
API_HASH=                         # [REQUIRED] e.g. a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4


# =============================================================================
# § 2  REDIS — PRIMARY CONNECTION                                [REQUIRED ×1]
# =============================================================================
# REDIS_URL is used when Redis Sentinel is disabled (local dev, single-node
# staging). In production, this value is ignored in favour of
# REDIS_SENTINEL_HOSTS + REDIS_SENTINEL_MASTER_NAME.
#
# Format: redis://[:<password>@]<host>:<port>/<db>
#         rediss:// prefix enables TLS (recommended for cross-DC replication)
#
# src/redis/client.py reads REDIS_SENTINEL_HOSTS first; falls back to
# REDIS_URL only when REDIS_SENTINEL_HOSTS is empty.
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0 # [REQUIRED] Single-node fallback URL


# =============================================================================
# § 3  REDIS SENTINEL — HIGH AVAILABILITY                        [REQUIRED ×2]
# =============================================================================
# Required for production. Must define a 3-node Sentinel cluster (quorum=2).
# See deploy/sentinel/sentinel.conf and ADR docs/adr/001-redis-as-sot.md.
#
# REDIS_SENTINEL_HOSTS
#   Comma-separated list of host:port pairs for all Sentinel nodes.
#   Minimum 3 nodes required for quorum=2 to tolerate a single-node failure.
#   Format: host1:port,host2:port,host3:port
#   No spaces. No trailing comma.
#
# REDIS_SENTINEL_MASTER_NAME
#   The logical master name configured in sentinel.conf.
#   Must match the `sentinel monitor <name>` value exactly (case-sensitive).
#
# REDIS_SENTINEL_PASSWORD
#   Optional password for Sentinel nodes. Leave blank if Sentinel runs
#   without authentication (acceptable on a private VPC; not on public nets).
#
# REDIS_PASSWORD
#   Optional password for the Redis master/replica data nodes.
#   Independent from Sentinel password.
# -----------------------------------------------------------------------------

REDIS_SENTINEL_HOSTS=             # [REQUIRED in prod] e.g. 10.0.0.1:26379,10.0.0.2:26379,10.0.0.3:26379
REDIS_SENTINEL_MASTER_NAME=jukebox # [REQUIRED in prod] must match sentinel.conf
REDIS_SENTINEL_PASSWORD=          # [OPTIONAL] blank = no auth on Sentinel nodes
REDIS_PASSWORD=                   # [OPTIONAL] blank = no auth on Redis data nodes


# =============================================================================
# § 4  REDIS — POOL & NAMESPACE                                  [OPTIONAL]
# =============================================================================
# Controls connection pool sizing and the key namespace prefix.
# See src/redis/pool.py and src/redis/keys.py.
#
# REDIS_MAX_CONNECTIONS
#   Hard ceiling on connections per pool. At 500 concurrent voice-chat groups,
#   peak demand is ~250 concurrent coroutines (download + stream + heartbeat
#   per group). Default 300 provides 20% headroom.
#   Raising above 500 is not recommended without increasing Redis maxclients.
#
# REDIS_KEY_PREFIX
#   Namespace injected before every key built by src/redis/keys.py.
#   Format enforced: jukebox:{env}:
#   Valid env values: prod | staging | test
#   Changing this in production without a migration script orphans all
#   existing queue and playback state keys.
# -----------------------------------------------------------------------------

REDIS_MAX_CONNECTIONS=300          # [OPTIONAL] default: 300
REDIS_KEY_PREFIX=jukebox:prod:     # [OPTIONAL] default: jukebox:prod: — change env segment per deployment


# =============================================================================
# § 5  AUDIO CACHE — FILESYSTEM                                  [OPTIONAL]
# =============================================================================
# Controls the on-disk audio blob store. See src/cache/ and HLA §1 (CacheManager).
#
# CACHE_DIR
#   Absolute path to the LRU audio cache directory.
#   Must be on a volume with at least CACHE_MAX_SIZE_GB + 2 GB free.
#   The systemd unit mounts this path; do not change without updating
#   deploy/systemd/jukebox-bot.service and docker-compose.yml.
#
# CACHE_MAX_SIZE_GB
#   Hard ceiling on total disk usage for cached audio files.
#   When free space drops below CACHE_EVICTION_THRESHOLD_MB, CacheManager
#   runs a synchronous LRU sweep before accepting new downloads.
#   HLA specifies 20 GB; do not reduce below 5 GB in production.
#
# CACHE_EVICTION_THRESHOLD_MB
#   Pre-download free-space floor. If available space is below this value,
#   LRU eviction runs before the download starts.
#   Relates to HLA error CLASS I-2 (Disk Full recovery).
#
# CACHE_TTL_DAYS
#   Redis TTL for cache:meta:{sha256} keys (HLA §2, key 3).
#   Disk files are kept at least this long unless evicted by LRU pressure.
#   Default: 7 days (604800 seconds).
#
# TMPFS_MOUNT
#   Path to the tmpfs overlay used for currently-playing files.
#   Provides sub-millisecond seek latency for the active stream.
#   Mount must be provisioned by the host OS or docker-compose.yml.
# -----------------------------------------------------------------------------

CACHE_DIR=/var/jukebox/cache       # [OPTIONAL] default: /var/jukebox/cache
CACHE_MAX_SIZE_GB=20               # [OPTIONAL] default: 20 — HLA §1 CacheManager
CACHE_EVICTION_THRESHOLD_MB=500    # [OPTIONAL] default: 500 — CLASS I-2 recovery trigger
CACHE_TTL_DAYS=7                   # [OPTIONAL] default: 7 — maps to 604800s Redis TTL
TMPFS_MOUNT=/tmp/jukebox-active    # [OPTIONAL] default: /tmp/jukebox-active


# =============================================================================
# § 6  DOWNLOAD WORKER                                           [OPTIONAL]
# =============================================================================
# Controls yt-dlp concurrency, retry behaviour, and Redlock settings.
# See src/download/download_worker.py and HLA §1 (DownloadWorker).
#
# DOWNLOAD_MAX_CONCURRENT
#   asyncio.Semaphore value capping simultaneous yt-dlp downloads.
#   At 500 groups, peak simultaneous /play commands is bounded by
#   rate-limiting (RATE_LIMIT_REQUESTS_PER_MIN per user per group).
#   Default 8 is conservative; raise to 16 if download throughput is the
#   measured bottleneck (see scripts/load_test.sh).
#
# DOWNLOAD_RETRY_COUNT
#   Maximum retry attempts for RETRYABLE download failures (HTTP 429,
#   timeout). After this count the track is set to TrackStatus.FAILED.
#   HLA specifies × 3; do not raise above 5 (risks Telegram FloodWait).
#
# DOWNLOAD_RETRY_BASE_DELAY_S
#   Base delay in seconds for jittered exponential backoff between retries.
#   Actual delay = base × 2^attempt + uniform(0, base).
#
# REDLOCK_TTL_S
#   Hard TTL for download deduplication locks (HLA §2, key 4).
#   Must exceed the longest plausible download duration.
#   Default 300 s = 5 min hard ceiling per HLA spec.
#
# YTDLP_FORMAT
#   yt-dlp format selector string passed to --format.
#   Default selects best audio-only stream (no video download overhead).
#   Changing this may break the Opus/PCM pipeline if a non-audio
#   container is selected.
# -----------------------------------------------------------------------------

DOWNLOAD_MAX_CONCURRENT=8          # [OPTIONAL] default: 8
DOWNLOAD_RETRY_COUNT=3             # [OPTIONAL] default: 3 — HLA §1 DownloadWorker
DOWNLOAD_RETRY_BASE_DELAY_S=2      # [OPTIONAL] default: 2
REDLOCK_TTL_S=300                  # [OPTIONAL] default: 300 — HLA §2 key 4
YTDLP_FORMAT=bestaudio/best        # [OPTIONAL] default: bestaudio/best


# =============================================================================
# § 7  STREAM ENGINE — FFMPEG & VOICE CHAT                       [OPTIONAL]
# =============================================================================
# Controls FFmpeg subprocess lifecycle, Opus pipeline, and resource limits.
# See src/stream/ and HLA §1 (StreamEngine, FFmpegProcess).
#
# FFMPEG_EXECUTABLE
#   Absolute path to the FFmpeg binary. Must support libopus.
#   Verify: ffmpeg -codecs | grep opus
#
# FFMPEG_MAX_SUBPROCESSES
#   Global asyncio.Semaphore ceiling for simultaneous FFmpeg subprocesses.
#   HLA formula: min(active_voice_chats, CPU_COUNT × 4).
#   src/config.py computes the dynamic ceiling at startup; this value sets
#   the static upper bound that overrides the formula if lower.
#   Relates to HLA error CLASS VI-1 and tests/chaos/test_ffmpeg_semaphore.py.
#
# FFMPEG_KILL_TIMEOUT_S
#   Seconds to wait after SIGTERM before escalating to SIGKILL.
#   HLA specifies 5 s. Do not reduce below 2 s (FFmpeg needs time to flush
#   the Opus encoder buffer cleanly).
#
# FFMPEG_OPUS_BITRATE
#   Opus encoder target bitrate (kbps). 128 is transparent for music.
#   Reduce to 96 or 64 if upstream bandwidth is constrained.
#
# STREAM_HEARTBEAT_INTERVAL_S
#   Cadence (in seconds) at which StreamEngine writes position_ms to Redis.
#   HLA specifies 1 Hz. Reducing below 0.5 increases Redis write pressure.
#   Raising above 2 degrades seek precision after a crash recovery (CLASS III-1).
#
# STREAM_STALL_TIMEOUT_S
#   If position_ms has not advanced for this many seconds while
#   status=PLAYING, the health watchdog treats the FFmpeg process as stalled
#   and triggers the CLASS III-2 (pipe deadlock) recovery path.
# -----------------------------------------------------------------------------

FFMPEG_EXECUTABLE=/usr/bin/ffmpeg  # [OPTIONAL] default: /usr/bin/ffmpeg
FFMPEG_MAX_SUBPROCESSES=64         # [OPTIONAL] default: 64 — overridden by CPU_COUNT×4 if lower
FFMPEG_KILL_TIMEOUT_S=5            # [OPTIONAL] default: 5 — HLA §1 FFmpegProcess
FFMPEG_OPUS_BITRATE=128            # [OPTIONAL] default: 128 kbps
STREAM_HEARTBEAT_INTERVAL_S=1      # [OPTIONAL] default: 1 — HLA §2 key 2 (position_ms heartbeat)
STREAM_STALL_TIMEOUT_S=10          # [OPTIONAL] default: 10 — CLASS III-2 pipe deadlock detection


# =============================================================================
# § 8  QUEUE MANAGER — LIMITS & DEFAULTS                         [OPTIONAL]
# =============================================================================
# Per-group queue constraints. These are system-wide defaults; individual
# groups override them via /settings stored in settings:{group_id} Redis HASH.
# See src/queue/ and HLA §2 key 5 (Per-Group Settings).
#
# QUEUE_MAX_LENGTH
#   Maximum tracks allowed in a group queue. Enforced by QueueManager.enqueue
#   which raises QueueFullError on violation.
#
# QUEUE_MAX_TRACK_DURATION_S
#   Maximum track duration accepted by on_play_command before enqueueing.
#   Prevents abuse via multi-hour streams. Default 600 s = 10 min.
#
# QUEUE_DEFAULT_VOLUME
#   Initial volume for new voice-chat sessions. Float 0.0–1.0.
#   Stored as string in playback:state:{group_id} HASH per HLA §2 key 2.
#
# QUEUE_TTL_S
#   Redis TTL for queue:{group_id} LIST (HLA §2 key 1).
#   Reset on every RPUSH. Default 86400 s = 24 h.
# -----------------------------------------------------------------------------

QUEUE_MAX_LENGTH=50                # [OPTIONAL] default: 50 — HLA §2 key 5
QUEUE_MAX_TRACK_DURATION_S=600     # [OPTIONAL] default: 600 (10 min)
QUEUE_DEFAULT_VOLUME=0.8           # [OPTIONAL] default: 0.8 — float 0.0–1.0
QUEUE_TTL_S=86400                  # [OPTIONAL] default: 86400 (24 h) — HLA §2 key 1


# =============================================================================
# § 9  RATE LIMITING                                             [OPTIONAL]
# =============================================================================
# Sliding-window per-user-per-group rate limiter.
# See src/gateway/middleware/rate_limiter.py and HLA §2 key 6.
#
# RATE_LIMIT_REQUESTS_PER_MIN
#   Maximum /play commands a single user may issue per group per minute.
#   Stored as settings.max_requests_per_min in GroupSettings.
#   Enforced via ratelimit:{user_id}:{group_id} STRING with 60 s TTL.
#
# RATE_LIMIT_ANNOUNCE_THROTTLE
#   Token-bucket ceiling for track announcement messages per group per minute.
#   Prevents Telegram FloodWait (CLASS IV-1). Default 20 matches Telegram's
#   documented soft limit for bot messages in a group.
# -----------------------------------------------------------------------------

RATE_LIMIT_REQUESTS_PER_MIN=5      # [OPTIONAL] default: 5 — HLA §2 key 6
RATE_LIMIT_ANNOUNCE_THROTTLE=20    # [OPTIONAL] default: 20 msg/min — CLASS IV-1 prevention


# =============================================================================
# § 10  CRASH RECOVERY                                           [OPTIONAL]
# =============================================================================
# Controls the StreamEngine watchdog retry logic.
# See src/stream/watchdog.py and HLA §4.2 (FFmpeg crash walk-through).
#
# CRASH_COUNT_THRESHOLD
#   Number of consecutive crashes on the same track before it is classified
#   FATAL, evicted from cache, and skipped. HLA specifies 3.
#   Do not raise above 5; repeated FFmpeg crashes on the same file indicate
#   a corrupt or incompatible audio container.
#
# CRASH_COUNT_TTL_S
#   Redis TTL for crash:count:{group_id} STRING (HLA §2 key 8).
#   Auto-evicts after a quiet period. Default 300 s = 5 min.
# -----------------------------------------------------------------------------

CRASH_COUNT_THRESHOLD=3            # [OPTIONAL] default: 3 — HLA §4.2 FATAL threshold
CRASH_COUNT_TTL_S=300              # [OPTIONAL] default: 300 — HLA §2 key 8


# =============================================================================
# § 11  LOGGING & OBSERVABILITY                                  [OPTIONAL]
# =============================================================================
# Controls structlog output format and level.
# See src/logging/setup.py. group_id is a mandatory context key on every
# log record (HLA cross-cutting concern §1).
#
# LOG_LEVEL
#   Minimum log level emitted. DEBUG produces very high volume in production
#   (one record per heartbeat tick per group). Use INFO in prod.
#   Valid: DEBUG | INFO | WARNING | ERROR | CRITICAL
#
# LOG_FORMAT
#   json     — newline-delimited JSON (for log aggregators: Loki, Datadog, ELK)
#   console  — human-readable coloured output (dev only)
#
# LOG_INCLUDE_TRACEBACK
#   Whether to include full Python tracebacks in structured error logs.
#   Always true in DEBUG; optional in INFO to reduce log volume.
#
# MONITORING_GROUP_ID
#   Telegram group_id of the ops monitoring group. If set, the bot sends
#   CRITICAL-severity alerts (CLASS II-2 download failure spike, CLASS I-1
#   Redis partition) to this group. Leave blank to disable.
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO                     # [OPTIONAL] default: INFO
LOG_FORMAT=json                    # [OPTIONAL] default: json — use console for local dev
LOG_INCLUDE_TRACEBACK=true         # [OPTIONAL] default: true
MONITORING_GROUP_ID=               # [OPTIONAL] blank = ops alerts disabled


# =============================================================================
# § 12  DEPLOYMENT ENVIRONMENT                                   [OPTIONAL]
# =============================================================================
# Runtime environment tag. Injected into Redis key prefix and structured logs.
#
# ENV
#   prod | staging | test
#   Controls: Redis key namespace (jukebox:{env}:), log verbosity defaults,
#   and whether chaos test fixtures are permitted to activate.
#   src/config.py raises ValueError if ENV=prod and CHAOS_TESTS_ENABLED=1.
#
# CHAOS_TESTS_ENABLED
#   Must be 0 in prod and staging. Setting to 1 enables testcontainers
#   fixtures and fault-injection paths used by tests/chaos/.
#   Blocked at startup if ENV=prod.
#
# BOT_WORKERS
#   Number of aiogram worker tasks for update processing.
#   Default 4 is appropriate for ≤500 concurrent groups. Raise to 8 for
#   higher command throughput; aiogram is I/O-bound so linear scaling holds.
# -----------------------------------------------------------------------------

ENV=prod                           # [OPTIONAL] default: prod — valid: prod | staging | test
CHAOS_TESTS_ENABLED=0              # [OPTIONAL] default: 0 — MUST be 0 in prod (enforced by config.py)
BOT_WORKERS=4                      # [OPTIONAL] default: 4
