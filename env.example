# Telegram Jukebox Bot - Environment Configuration Template
# Copy this file to .env and fill in your values

# ===== Telegram Bot =====
# Get token from @BotFather: https://t.me/botfather
JUKEBOX_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your Telegram user ID (use @userinfobot to find it)
JUKEBOX_BOT_OWNER_ID=123456789

# ===== Telegram MTProto (for pytgcalls voice chat) =====
# Get credentials from https://my.telegram.org/apps
JUKEBOX_PYROGRAM_API_ID=12345678
JUKEBOX_PYROGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Optional: Pyrogram session string (generate with pyrogram-session-gen)
# JUKEBOX_PYROGRAM_SESSION_STRING=

# ===== Redis (Sentinel HA) =====
# Sentinel hosts (comma-separated)
JUKEBOX_REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
JUKEBOX_REDIS_MASTER_NAME=jukebox-master
JUKEBOX_REDIS_PASSWORD=your_redis_password_here
# JUKEBOX_REDIS_SENTINEL_PASSWORD=sentinel_password_here  # Optional: separate Sentinel password
JUKEBOX_REDIS_DB=0

# Alternative: Single Redis instance (for development only)
# JUKEBOX_REDIS_URL=redis://localhost:6379/0

# ===== Environment =====
JUKEBOX_ENVIRONMENT=prod  # prod, dev, test

# ===== Storage =====
JUKEBOX_MAX_CACHE_SIZE_GB=20
JUKEBOX_CACHE_DIR=/var/cache/jukebox
JUKEBOX_TMPFS_PATH=/dev/shm/jukebox

# ===== Streaming =====
# JUKEBOX_MAX_STREAMS=16  # Optional: defaults to cpu_count * 4

# ===== Logging =====
JUKEBOX_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
JUKEBOX_LOG_FORMAT=json  # json, console

# ===== Queue =====
JUKEBOX_MAX_QUEUE_SIZE=100

# ===== Health Check =====
JUKEBOX_HEALTH_CHECK_PORT=3000

# ===== Deployment Notes =====
# 1. Never commit .env to version control
# 2. Use Docker secrets in production: docker secret create redis_pass redis_password.txt
# 3. For Kubernetes: use Sealed Secrets or external-secrets-operator
# 4. Rotate secrets regularly
