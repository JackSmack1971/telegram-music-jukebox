[Unit]
Description=Telegram Jukebox Bot Service
Documentation=https://github.com/yourorg/jukebox-bot
After=network-online.target redis.service
Wants=network-online.target
Requires=redis.service

[Service]
Type=notify
WorkingDirectory=/opt/jukebox
ExecStart=/opt/jukebox/venv/bin/python -m src.main
Restart=always
RestartSec=5s
User=jukebox
Group=jukebox

# Resource limits
LimitNOFILE=65536
LimitNPROC=512
MemoryLimit=2G

# Environment
EnvironmentFile=/opt/jukebox/.env
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/jukebox"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jukebox /var/cache/jukebox /var/log/jukebox
ProtectKernelTunables=true
ProtectControlGroups=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jukebox

[Install]
WantedBy=multi-user.target
